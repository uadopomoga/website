---
export const prerender = false;
---

      <!-- Form -->
      <form id="contact-form" class="flex gap-4 flex-col" action="#">

        <label class="sr-only" for="name">Name</label>
          <input
            id="name"
            type="text"
            name="name"
            class="border-2 rounded-lg text-center bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3"
            placeholder="Ім'я та прізвище"
            required
          />


        <label class="sr-only" for="email">Email</label>
        <input
          id="email"
          type="email"
          name="email"
          class="border-2 rounded-lg text-center bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3"
          placeholder="Email"
          required
        />

        <label class="sr-only" for="message">Email</label>
        <textarea 
          id="message" 
          name="message"
          class="border-2 rounded-lg text-center focus:text-left bg-bs-surface-0 border-bs-surface-3 form-input px-4 py-3" 
          placeholder="Ваше повідомлення..."
          required
        />
        
        <input type="submit" value='Надіслати' class="bs-btn form-input px-4 py-3">

      </form>

<script>
console.log('ContactForm script loaded');

function initContactForm() {
  console.log('Initializing contact form');
  const form = document.getElementById('contact-form') as HTMLFormElement;
  console.log('Found form:', form);
  
  if (!form) {
    console.error('Contact form not found! Retrying in 100ms...');
    setTimeout(initContactForm, 100);
    return;
  }
  
  console.log('Adding submit event listener to form');
  form.addEventListener('submit', async function(e) {
      console.log('Form submit event triggered');
      e.preventDefault();
      
      const submitButton = form.querySelector('input[type="submit"]') as HTMLInputElement;
      if (!submitButton) return;
      
      console.log('Starting form submission');
      const originalText = submitButton.value;
      submitButton.value = 'Надсилання...';
      submitButton.disabled = true;
      
      try {
        const formData = new FormData(form);
        
        console.log('About to make fetch request to /api/sendEmail.json');
        console.log('FormData contents:');
        for (let [key, value] of formData.entries()) {
          console.log(key, value);
        }
        
        const response = await fetch('/api/sendEmail.json', {
          method: 'POST',
          body: formData
        });
        
        console.log('Fetch completed');
        console.log('Response status:', response.status);
        console.log('Response headers:', response.headers.get('content-type'));
        console.log('Response URL:', response.url);
        
        // Get response text first to debug
        const responseText = await response.text();
        console.log('Response text:', responseText);
        console.log('Response text length:', responseText.length);
        
        let result;
        try {
          result = JSON.parse(responseText);
        } catch (jsonError) {
          console.error('Failed to parse JSON response:', jsonError);
          console.error('Response was:', responseText);
          result = { message: 'Отримано недійсну відповідь від сервера' };
        }
        
        if (response.ok) {
          alert('Повідомлення успішно надіслано!');
          form.reset();
        } else {
          alert(`Помилка: ${result.message || 'Невідома помилка'}`);
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Виникла помилка при надсиланні повідомлення');
      } finally {
        submitButton.value = originalText;
        submitButton.disabled = false;
      }
    });
}

// Try to initialize immediately
initContactForm();

// Also try on DOMContentLoaded as backup
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initContactForm);
} else {
  // DOM is already loaded
  initContactForm();
}
</script>