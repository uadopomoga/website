---

import logo from '../assets/theme-images/logo.png'
import Image from 'astro/components/Image.astro'

const { settings, navigation } = Astro.props

---

<footer class="@container bs-container my-24 font-semibold text-bs-foreground-dark [&_a]:hover:text-bs-foreground-light [&_a]:transition-color [&_a]:duration-150" id="contact">

  <!-- Wrapper -->
  <div class="bg-bs-surface-2 p-6 md:p-16 rounded-xl grid md:grid-cols-2 gap-8">

      <!-- Left col -->
    <div class="w-full md:w-max flex flex-col gap-8 md:gap-0 justify-between text-bs-foreground-light">

      <!-- Logo -->
      <a class="flex flex-col sm:flex-row items-start sm:items-center group" href="#top" aria-label="Back to top">

        <Image src={logo} alt='' class="mb-2 sm:mb-0 group-hover:-rotate-180 group-hover:scale-80 transition-transform ease-bs-spring duration-1000 opacity-80 rounded-2xl" height="48" width="48" />
        <div class="flex flex-col sm:flex-row sm:items-center">
        <h2 class="bs-h3 ml-0 sm:ml-5"> {settings.title} — </h2>
        <h2 class="bs-h3 ml-0 sm:ml-1">{settings.demo.title}</h2>
        </div>
      </a>

      <!-- CTA Button -->
      <button type="button" class="min-w-full md:min-w-32 bs-btn block bg-bs-surface-3 mt-4 md:mt-0" onclick="demo.showModal()">
        { settings.demo.cta }
      </button>

      </div>

      <!-- Right col -->
      <div class="flex gap-10 md:gap-2 lg:gap-20 md:justify-end [&_a]:block md:[&_a]:px-5 [&_a]:py-2">

        <!-- Nav -->
        <nav class="flex flex-col">

          {navigation && Array.isArray(navigation) && navigation.map((item: { title: string; link: string }) =>

            <a href={ item.link }>
              { item.title }
            </a>

          )}

        </nav>

        <!-- Social links -->
        <nav class="flex flex-col">

          {settings.social_links.map((item: { title: string; link: string }) =>

            <a href={ item.link } target="_blank">
              { item.title }
            </a>

          )}

        </nav>

      </div>

  </div>


</footer>

