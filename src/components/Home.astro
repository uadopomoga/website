---
import global_settings from '../data/global_settings.json'

import Links from './Links.astro'

import { Image } from 'astro:assets'
import logo from '../assets/theme-images/logo.png'

const {title, content, main_fundraise} = Astro.props
---

<style>
  .home-section {
    min-height: 50vh;
    contain: layout style;
  }
  
  .home-logo {
    will-change: auto;
    transform: translateZ(0);
  }
  
  .home-cta {
    contain: layout;
  }
</style>

<section class="bs-container py-6 sm:py-8 flex flex-col lg:flex-row items-stretch gap-8 lg:gap-12 justify-between home-section">

  <!-- Logo, title and description of the project -->
  <div class="flex flex-col gap-4 sm:gap-6 lg:max-w-lg w-full items-start py-8 sm:py-16 lg:py-32 flex-1">

    <div class="flex items-center w-full">
      <a class="flex xl:min-w-16 group home-logo" href="/" aria-label='logo'>
        <Image 
          src={logo} 
          alt="logo" 
          width="96" 
          height="96" 
          class="opacity-80 rounded-2xl w-24 h-24 sm:w-24 sm:h-24 lg:w-24 lg:h-24 object-contain flex-shrink-0" 
          loading="eager"
          format="webp"
          quality={85}
          sizes="96px"
        />
      </a>
      <h1 class="bs-h1 ml-3 sm:ml-4 text-xl sm:text-2xl lg:text-3xl xl:text-4xl" set:html={title} />
    </div>

    <!-- Content and Call to action -->
    <div class="w-full border-l-1 pl-4 pt-2">
      <div class="bs-body-text text-base sm:text-lg xl:text-xl flex flex-col gap-3 sm:gap-4 [&_p]:last:text-bs-surface-2 pl-6" set:html={content}/>
      
      <div class="p-6 sm:p-8 rounded-none bg-bs-surface-0/5 home-cta mt-4">
        <a href={main_fundraise} class="bs-btn inline-block text-base sm:text-lg px-6 sm:px-8 py-3 sm:py-4" target="_blank" rel="noopener noreferrer">
          Підтримати проєкт
        </a>
      </div>
    </div>
  </div>

  <!-- Youtube and all links to project -->
  <div class="flex flex-col gap-4 sm:gap-6 lg:max-w-2xl w-full items-start lg:items-end py-8 sm:py-16 lg:py-32 flex-1">
    <Links settings={global_settings}/>
  </div>

</section>