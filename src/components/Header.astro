---
import navigation_content from '../data/navigation.json'

const {title} = Astro.props
---

<header class="wrapper bg-loop font-semibold">

  <!-- Wrapper -->
  <div class="bs-container py-4 sm:py-6 flex justify-between items-center">

    <!-- Desktop Navigation -->
      <nav class="hidden md:flex mx-auto self-stretch lg:gap-2">
        {navigation_content.nav.map(item =>
          <a class="bs-btn !bg-transparent before:translate-y-full hover:before:translate-y-0" href={item.link}>
            {item.title}
          </a>
        )}
      </nav>

    <!-- Mobile Navigation -->
      <!-- Logo button -->
      <div class="md:hidden flex items-center">
        <a href="/" class="text-xl sm:text-2xl font-bold text-bs-white active:text-bs-surface-2 transition-colors pt-3">
          {title}
        </a>
      </div>

      <!-- Mobile menu hamburger button -->
      <button 
        class="md:hidden relative z-50 p-3 text-bs-white hover:text-bs-primary transition-colors touch-manipulation"
        id="mobile-menu-toggle"
        aria-label="Відкрити меню"
        aria-expanded="false"
        type="button"
      >
        <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

  </div>

  <!-- Mobile Navigation Links-->
  <nav 
    class="md:hidden bg-bs-surface-2 border-t border-bs-surface-1 overflow-hidden transition-all duration-300 ease-in-out max-h-0" 
    id="mobile-menu"
  >
    <div class="py-4">
      {navigation_content.nav.map(item =>
        <a 
          class="block px-6 py-3 text-bs-surface-3 hover:text-bs-primary hover:bg-bs-surface-3/10 transition-colors text-lg font-medium border-l-4 border-transparent hover:border-bs-primary" 
          href={item.link}
        >
          {item.title}
        </a>
      )}
    </div>
  </nav>

</header>

<script>
  // Mobile menu toggle functionality with improved touch support
  document.addEventListener('DOMContentLoaded', function() {
    const menuToggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement | null;
    const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;
    
    if (menuToggle && mobileMenu) {
      // Function to toggle menu
      function toggleMenu(): void {
        const isExpanded = menuToggle!.getAttribute('aria-expanded') === 'true';
        
        if (isExpanded) {
          closeMenu();
        } else {
          openMenu();
        }
      }
      
      function openMenu(): void {
        mobileMenu!.style.maxHeight = mobileMenu!.scrollHeight + 'px';
        menuToggle!.setAttribute('aria-expanded', 'true');
        menuToggle!.innerHTML = `
          <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        `;
      }
      
      function closeMenu(): void {
        mobileMenu!.style.maxHeight = '0';
        menuToggle!.setAttribute('aria-expanded', 'false');
        menuToggle!.innerHTML = `
          <svg class="w-6 h-6 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        `;
      }
      
      // Add click event listener
      menuToggle.addEventListener('click', function(e: Event) {
        e.preventDefault();
        e.stopPropagation();
        toggleMenu();
      });
      
      // Add touch event listeners for better mobile support
      menuToggle.addEventListener('touchstart', function(e: TouchEvent) {
        e.preventDefault();
      }, { passive: false });
      
      menuToggle.addEventListener('touchend', function(e: TouchEvent) {
        e.preventDefault();
        e.stopPropagation();
        toggleMenu();
      }, { passive: false });
      
      // Close mobile menu when clicking on a link
      const mobileMenuLinks = mobileMenu.querySelectorAll('a');
      mobileMenuLinks.forEach(link => {
        link.addEventListener('click', function() {
          closeMenu();
        });
      });
      
      // Close menu when clicking outside
      document.addEventListener('click', function(e: Event) {
        const target = e.target as Node;
        if (target && !menuToggle!.contains(target) && !mobileMenu!.contains(target)) {
          closeMenu();
        }
      });
    }
  });
</script>
