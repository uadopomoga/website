---
import Image from "astro/components/Image.astro"
import bg_image from "../assets/bg-image.webp"
import ContactForm from "./ContactForm.astro"

const {contacts} = Astro.props
---

<aside class="@container bs-container bs-mt-lg" id="contacts">
  <!-- Wrapper -->
  <div class="p-6 md:py-16 relative rounded-xl overflow-hidden flex justify-center isolate w-full">
    <!-- Background image -->
    <Image 
      src={bg_image} 
      alt="" 
      format="webp" 
      height={1080} 
      width={1920} 
      class="rounded-xl overflow-hidden w-full h-full object-cover object-left absolute inset-0 opacity-50" 
    />

    <!-- Content container -->
    <div class="z-10 w-full max-w-5xl flex flex-col lg:flex-row gap-8">
      <!-- Left side: Contact information -->
      <div class="bg-bs-surface-3 text-bs-surface-2 p-6 md:p-10 rounded-xl flex flex-col gap-6 lg:w-2/5">
        <h2 class="bs-h2 text-left">{contacts.title}</h2>
        
        <!-- Address -->
        <div class="flex items-start gap-3 text-left">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-1 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          <div class="bs-body-text">
            <p>{contacts.address_street}, </p>
            <p>{contacts.address_city}</p>
          </div>
        </div>
        
        <!-- Phone -->
        <div class="flex items-start gap-3 text-left">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mt-1 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <div class="bs-body-text">
            <p>{contacts.name}</p>
            <a href={contacts.phone} class="text-bs-primary hover:underline">{contacts.phone}</a>
            <p class="text-bs-foreground-yellow text-sm">{contacts.working_hours}</p>
          </div>
        </div>
        
        <!-- Info -->
        <div class="flex items-start gap-3 text-left bs-body-text flex-col">
          <a class="font-semibold hover:underline" href={contacts.you_control} target="_blank">БЛАГОДІЙНА ОРГАНІЗАЦІЯ «БЛАГОДІЙНИЙ ФОНД «ЮАДОПОМОГА»</a>
          <p class="text-bs-foreground-yellow text-sm">Код ЄДРПОУ 45144495</p>
        </div>
      </div>

      <!-- Contact form -->
      <div class="bg-bs-surface-3 p-6 md:p-10 rounded-xl flex flex-col gap-6 lg:w-3/5">
        <h2 class="bs-h2 text-left text-bs-surface-2">Напишіть нам</h2>
        <div class="bs-body-text flex-grow text-bs-surface-2 ">
          Маєте питання чи пропозиції? Зв'яжіться з нами за допомогою форми нижче, і ми відповімо вам якнайшвидше.
        </div>
        <ContactForm />
      </div>
    </div>
  </div>
</aside>