---
import Image from "astro/components/Image.astro"

const { title, preview, image, image_alt, bg, link, cta } = Astro.props

---

<section class="bs-container bs-mt-lg" id="case-studies">

  <!-- Header -->
  { title && <h2 class="bs-h2 text-center md:text-left">{ title }</h2> }

  <!-- About -->
  <div class="bs-mt-md">


<!-- Wrapper -->
<div class="group @container">
  <article
    class:list={["relative isolate flex h-full w-full gap-6 overflow-hidden rounded-xl pt-[20rem] @md:pt-[28rem] @xl:justify-end @4xl:pt-0", bg]}>

    <Image
      src={image}
      alt={image_alt}
      class="drop-shadow-[0_200px_200px_rgba(0,0,0,0.5)] absolute left-0 mx-auto w-[90cqi] rounded-xl  @4xl:w-[60cqi] group-hover:scale-105 transition-transform duration-3000 ease-bs-spring transform-gpu -translate-y-95"
      loading="lazy"
      height="1024"
      width="768"
    />

    <!-- Content -->
    <div class="z-10 flex h-full w-full flex-col gap-6 bg-bs-surface-3 backdrop-blur-3xl p-6 @4xl:w-1/2 @4xl:p-20">

      <!-- Intro -->
      <div class="bs-body-text flex-grow text-balance" set:html={preview} />

      <!-- CTA -->
      <a href={link} class="bs-btn inline-block self-start @4xl:mt-12">
        {cta}
      </a>

    </div>

  </article>

</div>


  </div>

  

</section>

