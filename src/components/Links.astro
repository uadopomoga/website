---
const {settings} = Astro.props

---

<section id="links" class="w-full">
  <h2 class="bs-h3 mb-6 lg:text-right">Слідкуйте за нами у соцмережах</h2>

  <div class="space-y-8">
    
    <!-- YouTube -->
      <div class="aspect-video w-full overflow-hidden rounded-2xl max-w-4xl mx-auto">
        <div 
          class="w-full h-full bg-bs-surface-1 flex items-center justify-center cursor-pointer relative group youtube-placeholder"
          data-video-src={settings.main_video}
        >
          <div class="text-center">
            <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-3 bg-red-600 rounded-full flex items-center justify-center group-hover:bg-red-500 transition-colors">
              <svg class="w-8 h-8 sm:w-10 sm:h-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <p class="text-bs-surface-2 text-sm sm:text-base">Натисніть, щоб переглянути відео</p>
          </div>
        </div>
      </div>
    
      <!-- All other links to media -->
      <div class="lg:text-right ">
          <a 
            href={settings.linktree}
            class="inline-flex items-center gap-2 text-bs-primary hover:text-bs-primary-light transition-colors  bg-bs-surface-1 p-3 rounded-2xl"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            <span class="underline-offset-4 hover:underline text-2xl">Всі офіційні рахунки та посилання</span>
          </a>
      </div>

  </div>

</section>

<!-- Lazy YouTube Loading Script -->
<script is:inline defer>
  document.addEventListener('DOMContentLoaded', function() {
    const youtubeElements = document.querySelectorAll('.youtube-placeholder');
    
    youtubeElements.forEach(function(element) {
      element.addEventListener('click', function() {
        const videoSrc = this.getAttribute('data-video-src');
        if (videoSrc) {
          const iframe = document.createElement('iframe');
          iframe.className = 'w-full h-full';
          iframe.src = videoSrc + '&autoplay=1';
          iframe.title = 'YouTube video player';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          iframe.referrerPolicy = 'strict-origin-when-cross-origin';
          this.parentNode.replaceChild(iframe, this);
        }
      });
    });
  });
</script>
