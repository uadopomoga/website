---
import '../assets/css/global.css'
import '../assets/css/base.css'
import '../assets/css/layout.css'
import '../assets/css/text.css'
import '../assets/css/buttons.css'

import { Image } from 'astro:assets'
import bg_image from '../assets/bg-image.webp'
import Header from '../components/Header.astro'

const {title, description, theme_color, image, image_alt, url} = Astro.props

// Default social sharing image
const defaultImage = bg_image.src
---
<html lang="uk">

  <head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta name="theme-color" content='#18181b' />

	  <meta name="description" content={description} />
    <meta name="theme-color" content={theme_color} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image || defaultImage} />
    <meta property="og:image:alt" content={image_alt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="UAdopomoga" />
    <meta property="og:locale" content="uk_UA" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={url} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image || defaultImage} />
    <meta name="twitter:image:alt" content={image_alt} />

    <link rel="canonical" href={url} />

    <link rel="preload" href="/src/assets/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/src/assets/fonts/Inter-SemiBold.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/src/assets/fonts/InterDisplay-Regular.woff2" as="font" type="font/woff2" crossorigin>

    <style>
      @font-face {
        font-family: 'Inter';
        src: url('/src/assets/fonts/Inter-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url('/src/assets/fonts/Inter-SemiBold.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'InterDisplay';
        src: url('/src/assets/fonts/InterDisplay-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      :root {
        --font-inter: 'Inter', system-ui, sans-serif;
        --font-inter-display: 'InterDisplay', system-ui, sans-serif;
      }
    </style>

  </head>

	<body id="top">
		
		<Image src={bg_image} alt="bg_image" format="webp" height={1080} width={1920} class="absolute min-h-svh object-cover inset-0 bottom-auto -z-1 w-full h-auto opacity-40 mask-b-from-50%" loading='lazy'/>

		<Header title={title}></Header>

		<main id="main">
			<slot 
		/>
		</main>
	
		
