# Resend API
RESEND_API_KEY=your_api_key
CONTACT_EMAIL=your_email
RESEND_EMAIL=your_verified_domain

# Cloudflare Turnstile (values below are Cloudflare's always-pass test keys)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Decap CMS OAuth
OAUTH_GITHUB_CLIENT_ID=your_github_app_client_id
OAUTH_GITHUB_CLIENT_SECRET=your_github_app_client_secret
OAUTH_GITHUB_REPO_ID=repo_id

# Base
DOMAIN=your_domain
BASE_URL=https://your_domain
REPOSITORY=user/repo
BRANCH=branch_name